# BARAKA AI - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=BARAKA AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Database (PostgreSQL for production, SQLite for development)
DATABASE_URL=sqlite:///./baraka_ai.db
# DATABASE_URL=postgresql://user:password@localhost:5432/baraka_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Exchange API (Binance)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Exchange API (Bybit)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Trading
DEFAULT_PAPER_BALANCE=10000
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=5
MAX_LEVERAGE=1

# ML
MODEL_PATH=./models
DEFAULT_MIN_CONFIDENCE=0.70

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
