# BARAKA AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-string-in-production
APP_NAME=BARAKA AI
APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql+asyncpg://baraka:baraka_secret@localhost:5432/baraka_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-secure-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Required when ENVIRONMENT=production; keep these values private
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Trading
TRADING_MODE=paper
DEFAULT_PAPER_BALANCE=10000
MAX_LEVERAGE=1
RISK_PER_TRADE=0.005
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=5
MAX_PORTFOLIO_EXPOSURE=0.80
MAX_SYMBOL_EXPOSURE=0.30
MAX_CONSECUTIVE_LOSSES=5
MIN_CONFIDENCE=0.70
MIN_RISK_REWARD=1.5

# Exchange API (NEVER commit real keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Email (for alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Telegram (for alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
